# Environment variables for Docker Compose development

# Application
PORT=8080
NODE_ENV=development

# DynamoDB Local (for development)
DOCUMENT_API_ENDPOINT=http://dynamodb-local:8000
DOCUMENT_API_REGION=ru-central1
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
USE_DATABASE=true
DATABASE_URL=http://dynamodb-local:8000

# Secrets are injected only outside of this repo (.env, .env.local, CI).
# The bot itself is launched on the host via `npm run bot:start` with the
# full set of variables (see .env.example): TELEGRAM_BOT_TOKEN,
# DEEPSEEK_API_KEY, ENCRYPTION_KEY, REDIS_URL, ADMIN_TELEGRAM_IDS,
# BROKER_API_BASE_URL, BROKER_API_KEY_HEADER, DEFAULT_RISK_PER_TRADE,
# MAX_POSITIONS, DAILY_DRAWDOWN_LIMIT, TOTAL_DRAWDOWN_LIMIT.
