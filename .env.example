# =============================================================================
# Telegram Trading Bot — конфигурация
# Все секреты задаются только через .env. В коде нет хардкодов.
# Скопируйте в .env и заполните значения.
# =============================================================================

# --- Telegram ---
# Токен бота, выдаётся @BotFather.
TELEGRAM_BOT_TOKEN=

# --- DeepSeek ---
# API-ключ DeepSeek (deepseek-flash / deepseek-v4-pro).
DEEPSEEK_API_KEY=
# (Опционально) базовый URL API DeepSeek и модели.
DEEPSEEK_API_BASE_URL=https://api.deepseek.com
# Быстрый режим (аналог устаревшего deepseek-chat) и глубокий разбор
# (аналог устаревшего deepseek-reasoner). Можно задать свои значения.
DEEPSEEK_CHAT_MODEL=deepseek-flash
DEEPSEEK_REASONER_MODEL=deepseek-v4-pro

# --- Шифрование ---
# Ключ Fernet (32 байта, URL-safe base64, 44 символа с "=" в конце).
# Сгенерировать: npm run -s --silent tsx -e "import {createFernetKey} from './core/crypto'; console.log(createFernetKey())"
ENCRYPTION_KEY=

# --- Базы данных ---
# URL базы данных (для DynamoDB-совместимого API — endpoint).
# В docker-compose используется DOCUMENT_API_ENDPOINT; при его отсутствии
# endpoint берётся из DATABASE_URL.
DATABASE_URL=
# URL Redis для распределённых блокировок (SET NX PX). При отсутствии
# используется in-memory фолбэк.
REDIS_URL=

# --- Администраторы ---
# Telegram user_id администраторов через запятую: 111,222,333
ADMIN_TELEGRAM_IDS=

# --- Брокер ---
# Тип брокера: stub (заглушка с фейковыми данными, по умолчанию) |
# upscale (реальный брокер Upscale, https://api.upscale.trade).
BROKER_TYPE=stub
# Базовый URL API брокера. Для Upscale: https://api.upscale.trade
BROKER_API_BASE_URL=https://api.upscale.trade
# HTTP-заголовок, в котором брокер ожидает API-ключ. Для Upscale ключ
# передаётся как "Authorization: Bearer usk_<ключ>", поэтому здесь Authorization.
BROKER_API_KEY_HEADER=Authorization

# --- Дефолты риск-менеджмента ---
# Максимальный % баланса на одну сделку (по умолчанию 1.0).
DEFAULT_RISK_PER_TRADE=1
# Максимум одновременных позиций (по умолчанию 3).
MAX_POSITIONS=3
# Лимит дневной просадки, %, выше которой автопауза (по умолчанию 3).
DAILY_DRAWDOWN_LIMIT=3
# Лимит общей просадки, %, выше которой автостоп (по умолчанию 10).
TOTAL_DRAWDOWN_LIMIT=10
# Интервал торгового цикла в мс (по умолчанию 300000 = 5 минут).
# Увеличьте значение, если брокер часто возвращает 429 api_key_rate_limit_exceeded.
DECISION_INTERVAL_MS=300000

# --- Запуск ---
# true — запуск бота без подключения к Telegram (dry-run).
BOT_DRY_RUN=false