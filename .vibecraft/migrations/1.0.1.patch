+export function YandexLogin() {
+  const [embedded, setEmbedded] = useState<boolean | null>(null);
+  const [user, setUser] = useState<SessionUser | null>(null);
+  const [loading, setLoading] = useState(true);
+  const [loggingOut, setLoggingOut] = useState(false);
+  useEffect(() => {
+    let active = true;
+    const inFrame = window.self !== window.top;
+    setEmbedded(inFrame);
+    loadCurrentUser(inFrame)
+      .then((value) => {
+        if (active) setUser(value);
+      })
+      .catch(() => {
+        if (active) toast.error("Не удалось проверить вход");
+      })
+      .finally(() => {
+        if (active) setLoading(false);
+      });
+    return () => {
+      active = false;
+    };
+  }, []);
+  async function logout() {
+    setLoggingOut(true);
+    try {
+      const response = await fetch("/api/auth/logout", {
+        method: "POST",
+        credentials: "same-origin",
+      });
+      if (!response.ok) throw new Error("Logout failed");
+      setUser(null);
+    } catch {
+      toast.error("Не удалось выйти");
+    } finally {
+      setLoggingOut(false);
+    }
+  }
+  if (loading || embedded === null)
+    return (
+      <Skeleton
+        className="h-9 w-40"
+        role="status"
+        aria-label="Проверяем вход"
+      />
+    );
+  if (!user || embedded)
+    return (
+      <a
+        className={buttonVariants({ variant: "outline" })}
+        {...loginLink(embedded)}
+      >
+        <LogIn aria-hidden="true" />
+        Войти через Яндекс
+      </a>
+    );
+  return (
+    <div className="flex items-center gap-2">
+      <span>{user.displayName}</span>
+      <Button variant="outline" disabled={loggingOut} onClick={logout}>
+        <LogOut aria-hidden="true" />
+        Выйти
+      </Button>
+    </div>
+  );
+}
